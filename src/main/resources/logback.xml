<configuration>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/pikap.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- No ConsoleAppender at all -->
    <!-- Root logger only uses the file appender -->
    <root level="INFO">
        <appender-ref ref="FILE" />
    </root>
</configuration>
